rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Mặc định từ chối tất cả các yêu cầu đọc/ghi (Deny by default)
    match /{document=**} {
      allow read, write: if false;
    }

    // Quy tắc cho collection 'users'
    match /users/{userId} {
      // Chỉ Admin hoặc chính chủ tài khoản mới được đọc profile
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.role == 'admin');

      // Cho phép tạo nếu tài khoản trùng khớp và không được gán trước các trường role/status quyền lực
      allow create: if request.auth != null && request.auth.uid == userId 
        && !request.resource.data.keys().hasAny(['role', 'status']);

      // Cho phép cập nhật nếu là chính chủ và không thay đổi trường role/status (hoặc nếu là admin thì được đổi)
      allow update: if request.auth != null && (
        request.auth.token.role == 'admin' || (
          request.auth.uid == userId 
          && (!request.resource.data.keys().hasAny(['role', 'status']) 
              || (resource.data != null && request.resource.data.role == resource.data.role && request.resource.data.status == resource.data.status))
        )
      );

      // Chỉ Admin mới có quyền xóa tài khoản người dùng
      allow delete: if request.auth != null && request.auth.token.role == 'admin';
    }

    // Quy tắc cho collection 'products'
    match /products/{productId} {
      // Bất kỳ ai cũng có thể đọc danh sách sản phẩm (kể cả Guest)
      allow read: if true;

      // Chỉ Seller hoặc Admin mới có quyền tạo, sửa đổi hoặc xóa sản phẩm
      allow write: if request.auth != null && (
        request.auth.token.role == 'seller' || request.auth.token.role == 'admin'
      );
    }
  }
}
