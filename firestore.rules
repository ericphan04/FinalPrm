rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Mặc định từ chối tất cả các yêu cầu đọc/ghi (Deny by default)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions to check authentication and roles
    function signedIn() {
      return request.auth != null;
    }
    function roleIs(role) {
      return signedIn() && request.auth.token.role == role;
    }
    function isAdmin() {
      return roleIs('admin');
    }
    function isSeller() {
      return roleIs('seller');
    }

    // Quy tắc cho collection 'users'
    match /users/{userId} {
      // Chỉ Admin hoặc chính chủ tài khoản mới được đọc profile
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      // Cho phép tạo nếu tài khoản trùng khớp và không tự cấp quyền
      allow create: if signedIn() && (
        isAdmin() || (
          request.auth.uid == userId
          && !request.resource.data.keys().hasAny(['role', 'roleMirror', 'status'])
        )
      );

      // Cho phép cập nhật nếu là chính chủ và không thay đổi trường role/status (hoặc nếu là admin thì được đổi)
      allow update: if signedIn() && (
        isAdmin() || (
          request.auth.uid == userId 
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'roleMirror', 'status'])
        )
      );

      // Chỉ Admin mới có quyền xóa tài khoản người dùng
      allow delete: if isAdmin();

      // Cho phép truy cập vào các collection con (cart, favorites, v.v) của chính User đó
      match /cart/{itemId} {
        allow read, write: if signedIn() && (request.auth.uid == userId || isAdmin());
      }
      match /favorites/{productId} {
        allow read, write: if signedIn() && (request.auth.uid == userId || isAdmin());
      }
      match /addresses/{addressId} {
        allow read, write: if signedIn() && (request.auth.uid == userId || isAdmin());
      }
      match /fcm_tokens/{tokenId} {
        allow read, write: if signedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    // Quy tắc cho collection 'products'
    match /products/{productId} {
      // Bất kỳ ai cũng có thể đọc danh sách sản phẩm (kể cả Guest)
      allow read: if true;

      // Chỉ Seller mới được tạo sản phẩm (ở trạng thái draft), Admin được ghi đè mọi thứ
      allow create: if isAdmin() || (
        isSeller()
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.status == 'draft'
      );

      // Chỉ Seller sở hữu sản phẩm mới được sửa, hoặc Admin
      allow update: if isAdmin() || (
        isSeller()
        && resource.data.sellerId == request.auth.uid
        && request.resource.data.sellerId == resource.data.sellerId
      );

      // Chỉ Admin mới có quyền xóa sản phẩm
      allow delete: if isAdmin();

      // Variants subcollection
      match /variants/{variantId} {
        allow read: if true;
        allow write: if isAdmin() || (
          isSeller()
          && get(/databases/$(database)/documents/products/$(productId)).data.sellerId == request.auth.uid
        );
      }
    }

    // Quy tắc cho collection 'orders'
    match /orders/{orderId} {
      // Chỉ buyer, seller sở hữu đơn hoặc admin mới được đọc đơn
      allow read: if signedIn() && (
        resource.data.buyerId == request.auth.uid
        || resource.data.sellerId == request.auth.uid
        || isAdmin()
      );
      
      // Chỉ Cloud Functions ghi (client không được write)
      allow write: if false;
    }

    // Quy tắc cho collection 'checkouts'
    match /checkouts/{checkoutId} {
      allow read: if signedIn() && (resource.data.buyerId == request.auth.uid || isAdmin());
      allow write: if false; // Chỉ Cloud Functions ghi
    }

    // Quy tắc cho collection 'stores'
    match /stores/{storeId} {
      allow read: if true;
      allow write: if isAdmin() || (isSeller() && request.auth.uid == storeId);
    }

    // Quy tắc cho collection 'seller_applications'
    match /seller_applications/{applicationId} {
      // Chỉ chính chủ đơn ứng tuyển hoặc Admin mới có quyền đọc
      allow read: if signedIn() && (request.auth.uid == applicationId || isAdmin());
      // Cho phép gửi đơn ứng tuyển (chỉ tạo ở trạng thái pending)
      allow create: if signedIn() && request.auth.uid == applicationId
        && request.resource.data.status == 'pending';
      // Cho phép admin cập nhật (duyệt/từ chối)
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Quy tắc cho collection 'categories'
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin() || signedIn(); // Cho phép write nếu đã đăng nhập phục vụ seed
    }

    // Quy tắc cho collection 'notifications'
    match /notifications/{userId}/items/{notificationId} {
      allow read: if signedIn() && request.auth.uid == userId;
      // Chỉ cho phép cập nhật readAt từ client
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
      allow write: if false; // Tạo/Xóa do Cloud Functions
    }

    // Quy tắc cho collection 'auditLogs'
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Chỉ Cloud Functions ghi
    }

    // Quy tắc cho collection 'stats'
    match /stats/{statId} {
      allow read: if isAdmin() || roleIs('seller');
      allow write: if false; // Chỉ Cloud Functions ghi
    }

    // Quy tắc cho collection 'reviews'
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if false; // Chỉ Cloud Functions ghi
    }
  }
}
