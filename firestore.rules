rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Mặc định từ chối tất cả các yêu cầu đọc/ghi (Deny by default)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper function to get role of logged in user from Firestore
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Quy tắc cho collection 'users'
    match /users/{userId} {
      // Chỉ Admin hoặc chính chủ tài khoản mới được đọc profile
      allow read: if request.auth != null && (request.auth.uid == userId || getUserRole() == 'admin');

      // Cho phép tạo nếu tài khoản trùng khớp
      allow create: if request.auth != null && request.auth.uid == userId;

      // Cho phép cập nhật nếu là chính chủ và không thay đổi trường role/status (hoặc nếu là admin thì được đổi)
      allow update: if request.auth != null && (
        getUserRole() == 'admin' || (
          request.auth.uid == userId 
          && (!request.resource.data.keys().hasAny(['role', 'status']) 
              || (resource.data != null && request.resource.data.role == resource.data.role && request.resource.data.status == resource.data.status))
        )
      );

      // Chỉ Admin mới có quyền xóa tài khoản người dùng
      allow delete: if request.auth != null && getUserRole() == 'admin';
    }

    // Quy tắc cho collection 'products'
    match /products/{productId} {
      // Bất kỳ ai cũng có thể đọc danh sách sản phẩm (kể cả Guest)
      allow read: if true;

      // Chỉ Seller hoặc Admin mới có quyền tạo, sửa đổi hoặc xóa sản phẩm
      allow write: if request.auth != null && (
        getUserRole() == 'seller' || getUserRole() == 'admin'
      );
    }

    // Quy tắc cho collection 'orders'
    match /orders/{orderId} {
      // Người mua có thể xem đơn của chính mình, Người bán & Admin có thể xem tất cả
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        getUserRole() == 'seller' ||
        getUserRole() == 'admin'
      );
      
      // Cho phép Seller và Admin cập nhật trạng thái đơn (kèm theo validate transition ở code/functions)
      allow write: if request.auth != null && (
        getUserRole() == 'seller' ||
        getUserRole() == 'admin'
      );
    }

    // Quy tắc cho collection 'stores'
    match /stores/{storeId} {
      // Bất kỳ ai cũng có thể xem thông tin cửa hàng
      allow read: if true;
      
      // Chỉ chính chủ cửa hàng hoặc Admin mới được ghi
      allow write: if request.auth != null && (
        request.auth.uid == storeId ||
        getUserRole() == 'admin'
      );
    }

    // Quy tắc cho collection 'seller_applications'
    match /seller_applications/{applicationId} {
      // Chỉ chính chủ đơn ứng tuyển hoặc Admin mới có quyền đọc/ghi
      allow read, write: if request.auth != null && (
        request.auth.uid == applicationId ||
        getUserRole() == 'admin'
      );
    }

    // Quy tắc cho collection 'categories'
    match /categories/{categoryId} {
      // Bất kỳ ai cũng có thể đọc danh mục (kể cả Guest)
      allow read: if true;
      
      // Cho phép ghi nếu đã đăng nhập (phục vụ tự động seed ở client)
      allow write: if request.auth != null;
    }
  }
}
